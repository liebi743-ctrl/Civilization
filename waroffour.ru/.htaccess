php_value session.use_only_cookies 0
php_flag session.use_trans_sid off
php_value session.use_trans_sid 0
php_flag session.use_cookies on

php_value session.gc_maxlifetime 2678400
php_value session.cookie_lifetime 2678400

php_flag session.auto_start on
php_value session.auto_start 1 

php_value error_reporting 0
php_value display_errors 0

<Files script124_cron.php>
order allow,deny
deny from all
</Files>
<Files cataclizma22.php>
order allow,deny
deny from all
</Files>
<Files clear.php>
order allow,deny
deny from all
</Files>
<Files config.php>
order allow,deny
deny from all
</Files>
<FilesMatch ".dat">
order allow,deny
deny from all
</FilesMatch>
<FilesMatch ".txt">
order allow,deny
deny from all
</FilesMatch>
<FilesMatch ".inc">
order allow,deny
deny from all
</FilesMatch>

order allow,deny
deny from 77.43.192.133
deny from 195.154.241.150
\


allow from all

AddDefaultCharset UTF-8

ErrorDocument 400 /index.php?erro=400
ErrorDocument 401 /index.php?erro=401
ErrorDocument 402 /index.php?erro=402
ErrorDocument 403 /index.php?erro=403
ErrorDocument 404 /index.php?erro=404
ErrorDocument 500 /index.php?erro=500
ErrorDocument 502 /index.php?erro=502
RewriteCond %{QUERY_STRING} base64_encode.*\(.*\) [OR]
RewriteCond %{QUERY_STRING} http:.*\/.*\/ [OR]
RewriteCond %{QUERY_STRING} ..*\/ [OR]
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
RewriteCond %{REQUEST_METHOD} ^TRACE
RewriteRule ^(.*)$ index.php [F,L]
php_flag zlib.output_compression On